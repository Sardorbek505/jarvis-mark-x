{
  "manifest_version": 3,
  "name": "JARVIS Media Bridge",
  "version": "1.0.0",
  "description": "Автоматический мост синхронизации и управления HTML5 веб-плеерами для JARVIS Mark X",
  "permissions": [
    "tabs",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end",
      "all_frames": true
    }
  ]
}
