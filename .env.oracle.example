# ──────────────────────────────────────────────────────────────────────────────
# JARVIS — секреты для Oracle Cloud деплоя.
# Скопируй в .env (БЕЗ .example) на сервере и заполни своими значениями.
#   cp .env.oracle.example .env && nano .env
# Файл .env в .gitignore — в репозиторий не попадёт.
# ──────────────────────────────────────────────────────────────────────────────

# Твой бесплатный домен DuckDNS, указывающий на IP этой VM (без https://)
DOMAIN=jarvismarkx.duckdns.org

# Публичный HTTPS-адрес — тот же домен, но со схемой. Нужен для webhook и Mini App.
MINIAPP_URL=https://jarvismarkx.duckdns.org

# ── Gemini ──────────────────────────────────────────────────────────────────
GEMINI_API_KEY=сюда_ключ_с_aistudio.google.com/apikey
GEMINI_MODEL=gemini-2.5-flash

# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=токен_от_@BotFather
TELEGRAM_ALLOWED_USERS=твой_user_id   # узнать у @userinfobot; несколько через запятую

# ── Связь с домашним ПК (управление компьютером) ──────────────────────────────
# Придумай длинный случайный токен. ТОТ ЖЕ токен впиши на ПК в config/api_keys.json.
PC_LINK_TOKEN=придумай_длинный_секрет

# ── Локация по умолчанию (если телефон не сообщил свою) ───────────────────────
DEFAULT_CITY=Шымкент
TIMEZONE=Asia/Almaty
