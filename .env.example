# JARVIS Environment Variables

# Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Запасные модели Telegram-бота на случай исчерпанной квоты Gemini
# (telegram_bot/fallback_llm.py). Любые из трёх, порядок: Groq → OpenRouter → Mistral.
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# MISTRAL_API_KEY=

# Telegram-бот (telegram_bot/) — свой бот от @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Ваш числовой ID (узнать у @userinfobot); несколько — через запятую
TELEGRAM_ALLOWED_USERS=123456789
# Публичный HTTPS-адрес сервера бота: отсюда адрес вебхука и Mini App
MINIAPP_URL=https://your-server.example.com
# Общий секрет связи сервера бота с этим ПК (тот же — в config/api_keys.json на ПК).
# Придумайте длинную случайную строку; пустой — связи с ПК нет.
PC_LINK_TOKEN=
# Необязательно: свой секрет вебхука (иначе — хеш токена бота)
# WEBHOOK_SECRET=

# Spotify API
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
SPOTIFY_REFRESH_TOKEN=your_spotify_refresh_token_here

# Optional: Google Calendar
GOOGLE_CALENDAR_ID=primary
