{
 "fps": 30,
 "bpm": 100,
 "beatFrames": 18,
 "durationInFrames": 1242,
 "scenes": [
  {
   "id": "boot",
   "from": 0,
   "durationInFrames": 180,
   "beats": 10,
   "vo": {
    "text": "Good evening. Allow me to introduce myself.",
    "from": 72,
    "durationInFrames": 90
   }
  },
  {
   "id": "title",
   "from": 180,
   "durationInFrames": 108,
   "beats": 6,
   "vo": {
    "text": "I am Jarvis. Mark Ten.",
    "from": 14,
    "durationInFrames": 64
   }
  },
  {
   "id": "voice",
   "from": 288,
   "durationInFrames": 180,
   "beats": 10,
   "vo": {
    "text": "Speak naturally, and I answer instantly. You can even interrupt me.",
    "from": 10,
    "durationInFrames": 141
   }
  },
  {
   "id": "vision",
   "from": 468,
   "durationInFrames": 162,
   "beats": 9,
   "vo": {
    "text": "I see your screen, read your code, and find the bug before you do.",
    "from": 10,
    "durationInFrames": 136
   }
  },
  {
   "id": "memory",
   "from": 630,
   "durationInFrames": 162,
   "beats": 9,
   "vo": {
    "text": "I remember what matters. Your notes, your plans, your preferences.",
    "from": 10,
    "durationInFrames": 137
   }
  },
  {
   "id": "control",
   "from": 792,
   "durationInFrames": 180,
   "beats": 10,
   "vo": {
    "text": "Open an app. Turn it down. Send it to your phone. Consider it done.",
    "from": 10,
    "durationInFrames": 139
   }
  },
  {
   "id": "end",
   "from": 972,
   "durationInFrames": 270,
   "beats": 15,
   "vo": {
    "text": "Jarvis, Mark Ten. Your personal A.I. for Windows. Free, and ready when you are.",
    "from": 27,
    "durationInFrames": 165
   }
  }
 ],
